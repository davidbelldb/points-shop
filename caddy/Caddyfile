sneakypoints.com {
    encode gzip zstd

    @admin path /admin /admin/* /api/admin/*
    basicauth @admin {
        david $2a$14$vkQtJbp5G0/mcBzV8TYteOtnAMFisDOcttjVAoHRbjXRPmSYBvfee
    }

    @api path /api/* /media/*
    handle @api {
        reverse_proxy backend:3001
    }

    handle {
        root * /srv

        # Hashed build assets are immutable — cache hard.
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # Everything else (index.html, SPA routes, sw.js, public files) must
        # always revalidate, otherwise phones keep running stale app bundles
        # after a deploy (old clients can't complete the SneakyTime call
        # handshake against new ones). Revalidation is a cheap 304.
        @entry not path /assets/*
        header @entry Cache-Control "no-cache"

        # Stable public static files (sprites, icons, 3D models, fonts) —
        # these rarely change once deployed, so let phones cache them across
        # visits instead of revalidating on every load. Excludes sw.js and
        # the manifest, which must stay no-cache so PWA clients pick up
        # updates. 7 days balances freshness against repeat-visit speed.
        @static {
            path *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico *.glb *.gltf *.bin *.mp3 *.mp4 *.woff *.woff2 *.ttf
            not path /sw.js
        }
        header @static Cache-Control "public, max-age=604800"

        try_files {path} /index.html
        file_server
    }
}

www.sneakypoints.com {
    redir https://sneakypoints.com{uri} permanent
}
