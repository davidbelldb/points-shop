sneakypoints.com {
    encode gzip zstd

    # Edge basicauth guards the admin SPA *pages* only. The /api/admin/* API is
    # now enforced by session-based admin auth in the backend (see the onRequest
    # admin gate in backend/src/index.js) so the native app and browsers without
    # cached basic-auth creds can use admin features over the normal login.
    @admin path /admin /admin/* /journal /journal/*
    basicauth @admin {
        david $2a$14$vkQtJbp5G0/mcBzV8TYteOtnAMFisDOcttjVAoHRbjXRPmSYBvfee
    }

    @api path /api/* /media/*
    handle @api {
        reverse_proxy backend:3001
    }

    handle {
        root * /srv

        # 1. Hashed build assets — content-addressed, cache forever.
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # 2. Large 3D models and fonts — stable after deploy, cache 1 year.
        #    These are the biggest files (twirl.glb = 8 MB) and the main
        #    cause of slow first-load on Safari / PWA.
        @models {
            path *.glb *.gltf *.stl *.bin *.woff *.woff2 *.ttf
            not path /assets/*
        }
        header @models Cache-Control "public, max-age=31536000"

        # 3. Other stable public media — cache 7 days.
        @static {
            path *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico *.mp3 *.mp4
            not path /assets/*
        }
        header @static Cache-Control "public, max-age=604800"

        # 4. Everything else (index.html, SPA routes, sw.js, manifest) —
        #    must revalidate so deploys are never stale. Cheap 304 when unchanged.
        @entry {
            not path /assets/*
            not path *.glb *.gltf *.stl *.bin *.woff *.woff2 *.ttf
            not path *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico *.mp3 *.mp4
        }
        header @entry Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }
}

www.sneakypoints.com {
    redir https://sneakypoints.com{uri} permanent
}
