// Copy this file to Secrets.xcconfig and fill in the key.
//
// Secrets.xcconfig is gitignored: an iOS Maps key is restricted by bundle id
// rather than kept secret, but there's no reason to put it in the repo.
//
// The key must be a *Maps SDK for iOS* key restricted to com.david.sneakysocial.
// The web app's VITE_GOOGLE_MAPS_API_KEY will NOT work — it's restricted to a
// domain, and Google rejects it from an app.
//
// Leave it empty and the crow tracker falls back to Apple Maps.
GOOGLE_MAPS_API_KEY =
