POSTGRES_DB=points_shop
POSTGRES_USER=points_app
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# --- TURN (coturn) — fixes WebRTC video calls (Tic-Tac-Face, Sneaky Calls)
# that fail to connect on restrictive NATs/mobile networks. ---
# Generate with: openssl rand -hex 32
TURN_SECRET=replace-with-a-long-random-secret
# The Hetzner VPS's public IPv4 address (coturn must advertise this).
TURN_EXTERNAL_IP=replace-with-vps-public-ip
TURN_REALM=sneakypoints.com

# --- Native iOS push (APNs) for the Sneaky Social TestFlight/App Store build ---
# From Apple Developer → Certificates, IDs & Profiles → Keys (create a key with
# "Apple Push Notifications service (APNs)" enabled, download the .p8 ONCE).
APNS_KEY_ID=replace-with-10-char-key-id
# Apple Developer account Team ID (top-right of the developer portal).
APNS_TEAM_ID=replace-with-10-char-team-id
# The app's bundle identifier.
APNS_BUNDLE_ID=com.david.sneakystuff
# The .p8 key file, base64-encoded onto one line:
#   base64 -i AuthKey_XXXXXXXXXX.p8        (macOS)   then paste the output below
APNS_AUTH_KEY_BASE64=replace-with-base64-of-p8-file
# TestFlight + App Store builds use Apple's PRODUCTION gateway. Set to false
# only when testing a development build run directly from Xcode onto a device.
APNS_PRODUCTION=true
